---
/**
 * Category tag. Each content kind owns one hue so it reads the same everywhere:
 * tool = lime, pattern = violet, practice = cyan, guide = amber.
 */
export type TagKind = 'tool' | 'pattern' | 'practice' | 'guide' | 'neutral';

interface Props {
  kind?: TagKind;
  dot?: boolean;
  class?: string;
}

const { kind = 'neutral', dot = true, class: className } = Astro.props;
const tones: Record<TagKind, string> = {
  tool: 'text-accent-ink bg-accent/10 border-accent/25',
  pattern: 'text-violet-ink bg-violet/10 border-violet/25',
  practice: 'text-cyan-ink bg-cyan/10 border-cyan/25',
  guide: 'text-amber-ink bg-amber/10 border-amber/25',
  neutral: 'text-fg-muted bg-surface-2 border-line',
};
const dots: Record<TagKind, string> = {
  tool: 'bg-accent-ink',
  pattern: 'bg-violet-ink',
  practice: 'bg-cyan-ink',
  guide: 'bg-amber-ink',
  neutral: 'bg-fg-subtle',
};
---

<span class:list={['inline-flex h-6 items-center gap-1.5 rounded-full border px-2.5 font-mono text-[0.6875rem] tracking-wide', tones[kind], className]}>
  {dot && <span class:list={['size-1.5 rounded-full', dots[kind]]} aria-hidden="true" />}
  <slot />
</span>
