---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from '../ui/Button.astro';
import { nav, href } from '../../config/site';
---

<header class="sticky top-0 z-40 border-b border-line/0 transition-colors" data-header>
  <div class="absolute inset-0 -z-10 bg-bg/70 backdrop-blur-xl [mask-image:linear-gradient(to_bottom,#000_70%,transparent)]"></div>
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <Logo />
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={href(item.href)}
            class="rounded-full px-3.5 py-2 text-sm text-fg-muted transition hover:bg-surface-2 hover:text-fg"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <span class="hidden sm:block"><Button href="/#composer" size="sm">Compose a stack</Button></span>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('border-line', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
