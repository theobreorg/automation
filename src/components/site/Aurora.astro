---
/** Slow-drifting aurora glow plus blueprint grid, placed behind hero sections. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['pointer-events-none absolute inset-0 -z-10 overflow-hidden', className]} aria-hidden="true">
  <div class="absolute inset-0 bg-blueprint"></div>
  <div class="absolute -top-[20%] left-[8%] h-[70%] w-[55%] animate-drift rounded-full blur-[110px]" style="background: var(--glow-1)"></div>
  <div class="absolute top-[5%] right-[-5%] h-[60%] w-[45%] animate-drift rounded-full blur-[120px] [animation-delay:-8s]" style="background: var(--glow-2)"></div>
  <div class="absolute top-[40%] left-[35%] h-[45%] w-[35%] animate-drift rounded-full blur-[120px] [animation-delay:-14s]" style="background: var(--glow-3)"></div>
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-bg"></div>
</div>
