---
import { site, href } from '../../config/site';
---

<a href={href('/')} class="group inline-flex items-center gap-2.5 text-fg" aria-label={`${site.name} home`}>
  <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <rect x="5" y="20" width="22" height="5" rx="2" fill="var(--violet)" class="transition-transform duration-500 ease-out group-hover:translate-y-0.5" />
    <rect x="5" y="13.5" width="22" height="5" rx="2" fill="var(--cyan)" />
    <rect x="5" y="7" width="22" height="5" rx="2" fill="var(--accent)" class="transition-transform duration-500 ease-out group-hover:-translate-y-0.5" />
  </svg>
  <span class="text-[1.05rem] font-semibold tracking-[-0.02em]">{site.name}</span>
</a>
