---
/** Toggles data-theme on <html> and remembers the choice. */
---

<button
  type="button"
  data-theme-toggle
  class="relative inline-flex size-9 items-center justify-center rounded-full border border-line text-fg-muted transition hover:border-line-strong hover:text-fg"
  aria-label="Switch color theme"
>
  <svg class="theme-icon-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" stroke-linecap="round"></path>
  </svg>
  <svg class="theme-icon-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  :global([data-theme='dark']) .theme-icon-sun { display: block; }
  :global([data-theme='dark']) .theme-icon-moon { display: none; }
  :global([data-theme='light']) .theme-icon-sun { display: none; }
  :global([data-theme='light']) .theme-icon-moon { display: block; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });
</script>
