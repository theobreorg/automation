---
import { render } from 'astro:content';
import GuidanceEntryPage from '../../components/site/GuidanceEntryPage.astro';
import { getGuides } from '../../data/content';

export async function getStaticPaths() {
  const entries = await getGuides();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
---

<GuidanceEntryPage kind="guide" data={entry.data} hasBody={hasBody}>
  <Content />
</GuidanceEntryPage>
