---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Tag from '../components/ui/Tag.astro';
import { entryPath, getAllEntries, getPrinciples, kindMeta, type Kind } from '../data/content';
import { href } from '../config/site';

const [principles, entries] = await Promise.all([getPrinciples(), getAllEntries()]);
const kinds: Kind[] = ['pattern', 'practice', 'tool', 'guide'];
---

<BaseLayout title="Principles" description="The 11 principle areas of modern test automation, mapped to the patterns, practices, tools and guides that put them into practice.">
  <PageHeader eyebrow="Principles" crumbs={[{ label: 'Home', href: '/' }]}>
    <h1 class="mt-8 max-w-4xl text-h1 font-medium text-balance">
      Eleven principles, <span class="em-serif">mapped to practice.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-fg-muted">
      Each principle area lists the patterns, practices, tools and guides that put it into practice. Every scoring weight and guide in the app is grounded here.
    </p>
    <nav aria-label="Principles" class="mt-8 flex flex-wrap gap-2">
      {
        principles.map((p) => (
          <a
            href={`#${p.data.id}`}
            class="inline-flex h-8 items-center gap-2 rounded-full border border-line bg-surface/60 px-3 text-xs text-fg-muted backdrop-blur transition hover:border-line-strong hover:text-fg"
          >
            <span class="font-mono text-[0.625rem] text-fg-subtle">{String(p.data.number).padStart(2, '0')}</span>
            {p.data.title}
          </a>
        ))
      }
    </nav>
  </PageHeader>

  <div class="container-page">
    {
      principles.map((p) => {
        const linked = entries.filter((e) => e.principles.includes(p.data.id));
        return (
          <section id={p.data.id} class="grid scroll-mt-24 gap-8 border-t border-line py-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
            <div>
              <p class="font-mono text-sm text-accent-ink">{String(p.data.number).padStart(2, '0')}</p>
              <h2 class="mt-3 text-h2 font-medium">{p.data.title}</h2>
              <p class="mt-3 text-lg leading-relaxed text-fg-muted">{p.data.line}</p>
              <ul class="mt-6 space-y-3 text-[0.9375rem] leading-relaxed text-fg-muted">
                {p.data.points.map((pt) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.65em] h-px w-3 shrink-0 bg-line-strong" aria-hidden="true" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="space-y-6 lg:pt-9">
              {kinds.map((k) => {
                const items = linked.filter((e) => e.kind === k);
                return (
                  items.length > 0 && (
                    <div>
                      <Tag kind={k}>{kindMeta[k].plural}</Tag>
                      <ul class="mt-3 divide-y divide-line rounded-xl border border-line bg-surface">
                        {items.map((e) => (
                          <li>
                            <a
                              href={href(entryPath(e.kind, e.id))}
                              class="group flex items-center justify-between gap-4 px-4 py-3 text-sm text-fg-muted transition hover:text-fg"
                            >
                              {e.title}
                              <span class="text-fg-subtle transition group-hover:translate-x-0.5 group-hover:text-fg" aria-hidden="true">
                                →
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )
                );
              })}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>
