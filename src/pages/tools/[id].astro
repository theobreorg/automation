---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import EntryCard from '../../components/ui/EntryCard.astro';
import PrincipleLinks from '../../components/ui/PrincipleLinks.astro';
import { getLayers, getTools, getTraitLabels, languageLabels, resolveRelated } from '../../data/content';

export async function getStaticPaths() {
  const tools = await getTools();
  return tools.map((tool) => ({ params: { id: tool.id }, props: { tool } }));
}

const { tool } = Astro.props;
const t = tool.data;
const [layers, traitLabels, related] = await Promise.all([getLayers(), getTraitLabels(), resolveRelated(t.related)]);
const layerNames = t.layers.map((id) => layers.find((l) => l.id === id)?.data.name ?? id);
const weights = Object.entries(t.weights).sort((a, b) => Math.abs(b[1]) - Math.abs(a[1]));
const ups = weights.filter(([, w]) => w > 0);
const downs = weights.filter(([, w]) => w < 0);
const facts = [
  { label: 'Layers', value: layerNames.join(', ') },
  { label: 'Languages', value: t.languages.map((l) => languageLabels[l]).join(', ') },
  { label: 'License', value: t.license },
];
---

<BaseLayout title={t.name} description={t.summary}>
  <PageHeader eyebrow={t.name} crumbs={[{ label: 'Tools', href: '/tools' }]}>
    <div class="mt-8">
      <Tag kind="tool">Tool</Tag>
    </div>
    <h1 class="mt-5 text-h1 font-medium text-balance">{t.name}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-fg-muted">{t.summary}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href={t.url} variant="secondary" target="_blank" rel="noopener noreferrer" arrow>Official site</Button>
      <PrincipleLinks ids={t.principles} />
    </div>
  </PageHeader>

  <section class="container-page">
    <dl class="grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-3">
      {
        facts.map((f) => (
          <div class="bg-surface p-5">
            <dt class="label-mono text-fg-subtle">{f.label}</dt>
            <dd class="mt-3 text-sm text-fg">{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <div class="rounded-card border border-line bg-surface p-6 md:p-7">
        <p class="label-mono text-accent-ink">Strengths</p>
        <ul class="mt-5 space-y-3.5 text-[0.9375rem] leading-relaxed text-fg-muted">
          {
            t.strengths.map((s) => (
              <li class="flex gap-3">
                <svg class="mt-[0.3em] size-4 shrink-0 text-accent-ink" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="m3.5 8.3 2.8 2.8 6.2-6.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{s}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-card border border-line bg-surface p-6 md:p-7">
        <p class="label-mono text-amber-ink">Trade-offs</p>
        <ul class="mt-5 space-y-3.5 text-[0.9375rem] leading-relaxed text-fg-muted">
          {
            t.tradeoffs.map((s) => (
              <li class="flex gap-3">
                <svg class="mt-[0.3em] size-4 shrink-0 text-amber-ink" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 3.5v5.5M8 11.8v.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <span>{s}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-4 rounded-card border border-line bg-bg-elev p-6 md:p-7">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <p class="label-mono text-fg-subtle">How the Stack Composer scores {t.name}</p>
        <p class="font-mono text-xs text-fg-subtle">baseline {t.baseline}</p>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div>
          <p class="text-sm font-medium text-fg">Scores higher when your app has</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              ups.map(([trait, w]) => (
                <li class="inline-flex h-7 items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3 text-xs text-fg">
                  {traitLabels[trait] ?? trait}
                  <span class="font-mono text-accent-ink">+{w}</span>
                </li>
              ))
            }
          </ul>
        </div>
        {
          downs.length > 0 && (
            <div>
              <p class="text-sm font-medium text-fg">Scores lower when your app has</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {downs.map(([trait, w]) => (
                  <li class="inline-flex h-7 items-center gap-2 rounded-full border border-red/25 bg-red/10 px-3 text-xs text-fg">
                    {traitLabels[trait] ?? trait}
                    <span class="font-mono text-red-ink">{w}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="container-page pt-20">
        <p class="label-mono text-fg-subtle">Related</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <EntryCard entry={r} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
